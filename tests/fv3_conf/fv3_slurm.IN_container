#!/bin/bash
#SBATCH -e err
#SBATCH -o out
#SBATCH --job-name="@[JBNME]"
#SBATCH --account=@[ACCNR]
#SBATCH --qos=@[QUEUE]
#SBATCH --partition=@[PARTITION]
#SBATCH --nodes=@[NODES]
#SBATCH --ntasks-per-node=@[TPN]
#SBATCH --time=@[WLCLK]
@[EXCLUSIVE_NODES_OPT]

set -eux
echo -n " $( date +%s )," > job_timestamp.txt

set +x
MACHINE_ID=container
source ./module-setup.sh
if [[ ! -d modulefiles ]]; then
  mkdir modulefiles
  mv *.lua modulefiles
fi
module use $PWD/modulefiles
module load modules.fv3
module list
set -x

echo "Model started:  " $(date)

export OMP_NUM_THREADS=@[THRD]
export OMP_STACKSIZE=512M
export ESMF_RUNTIME_COMPLIANCECHECK=OFF:depth=4
export ESMF_RUNTIME_PROFILE=ON
export ESMF_RUNTIME_PROFILE_OUTPUT="SUMMARY"

# Avoid job errors because of filesystem synchronization delays
sync && sleep 1

# This "if" block is part of the rt.sh self-tests in error-test.conf.
if [ "${JOB_SHOULD_FAIL:-NO}" = WHEN_RUNNING ] ; then
    echo "The job should abort now, with exit status 1." 1>&2
    echo "If error checking is working, the metascheduler should mark the job as failed." 1>&2
    false
fi

# Locate the container runtime on the host.
if command -v apptainer &>/dev/null; then
  CONTAINERBIN=apptainer
elif command -v singularity &>/dev/null; then
  CONTAINERBIN=singularity
else
  echo "ERROR: neither apptainer nor singularity found on this host" >&2; exit 1
fi

# Build bind-mount flags from the comma-separated CONTAINER_BIND list.
BIND_FLAGS=""
if [[ -n "@[CONTAINER_BIND]" ]]; then
  IFS=',' read -r -a _bind_dirs <<< "@[CONTAINER_BIND]"
  for _dir in "${_bind_dirs[@]}"; do
    BIND_FLAGS="${BIND_FLAGS} -B ${_dir}"
  done
fi

# shellcheck disable=SC2086
srun ${PMI:-} --label --distribution=block:block -n @[TASKS] \
  ${CONTAINERBIN} exec ${BIND_FLAGS} "@[CONTAINER_IMG]" ./fv3.exe

echo "Model ended:    " $(date)
echo -n " $( date +%s )," >> job_timestamp.txt
